# Variables de entorno — Parroquia Jesús Obrero Backend
# Copia este archivo como .env y completa los valores reales

# ── Aplicación ─────────────────────────────────────────────
APP_NAME="Jesus Obrero API"
APP_VERSION="0.1.0"
DEBUG=True

# ── Base de Datos PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/jesus_obrero_db

# ── Seguridad JWT ───────────────────────────────────────────
# Genera tu clave con: openssl rand -hex 32
SECRET_KEY=cambia_esto_por_una_clave_segura_generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage (archivos/documentos subidos) ──────────────────
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=10
