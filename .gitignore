# ============================================================
# .gitignore Principal - Parroquia Jesús Obrero
# ============================================================

# --- Entornos Virtuales de Python ---
backend/venv/
backend/.venv/
venv/
.venv/
*.pyc

# --- Node.js / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
node_modules/
dist/

# --- Variables de Entorno y Claves (NUNCA SUBIR) ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# --- Archivos Subidos Localmente (Storage) ---
backend/app/uploads/*
!backend/app/uploads/.gitkeep

# --- Logs y Caché ---
*.log
npm-debug.log*
yarn-debug.log*
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# --- IDEs, Agentes y Sistemas Operativos ---
.vscode/
.idea/
.agents/
skills-lock.json
*.swp
*.swo
.DS_Store
Thumbs.db
